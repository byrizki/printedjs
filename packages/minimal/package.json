{
	"name": "@printedjs/minimal",
	"version": "0.0.0",
	"description": "Full bundled Printedjs package compiled to minimal and compact JavaScript",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./dist/*": "./dist/*"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --build"
	},
	"dependencies": {
		"@printedjs/browser": "workspace:*",
		"@printedjs/core": "workspace:*",
		"@printedjs/plugin-preset": "workspace:*",
		"@printedjs/plugin-views": "workspace:*"
	}
}
