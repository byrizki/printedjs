{
	"name": "@printedjs/cli",
	"version": "0.2.3",
	"description": "Headless PDF generation and command-line runner for Printedjs",
	"license": "MIT",
	"type": "module",
	"bin": {
		"printedjs": "./dist/cli.js",
		"headless-webview": "./bin/headless-webview",
		"headless-webview-linux-x64": "./bin/linux-x64/headless-webview",
		"headless-webview-darwin-arm64": "./bin/darwin-arm64/headless-webview",
		"headless-webview-darwin-x64": "./bin/darwin-x64/headless-webview",
		"headless-webview-win32-x64": "./bin/win32-x64/headless-webview.exe"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"bin"
	],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@printedjs/browser": "workspace:*",
		"@printedjs/core": "workspace:*",
		"@printedjs/plugin-preset": "workspace:*"
	},
	"peerDependencies": {
		"@playwright/test": "^1.50.0",
		"playwright": "^1.50.0",
		"puppeteer": "^23.0.0 || ^24.0.0 || ^25.0.0"
	},
	"peerDependenciesMeta": {
		"@playwright/test": {
			"optional": true
		},
		"playwright": {
			"optional": true
		},
		"puppeteer": {
			"optional": true
		}
	}
}
