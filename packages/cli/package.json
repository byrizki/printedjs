{
	"name": "@printedjs/cli",
	"version": "0.0.0",
	"description": "Headless PDF generation and command-line runner for Printedjs",
	"license": "MIT",
	"type": "module",
	"bin": {
		"printedjs": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@printedjs/browser": "workspace:*",
		"@printedjs/core": "workspace:*",
		"@printedjs/plugins": "workspace:*"
	},
	"peerDependencies": {
		"@playwright/test": "^1.50.0",
		"playwright": "^1.50.0"
	},
	"peerDependenciesMeta": {
		"@playwright/test": {
			"optional": true
		},
		"playwright": {
			"optional": true
		}
	}
}
