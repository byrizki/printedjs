{
	"name": "@printedjs/headless-webview",
	"version": "0.2.0",
	"description": "Cross-platform headless webview runtime and PDF pipeline for React Native and .NET, powered by Wry and UniFFI",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"react-native": "./dist/index.native.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"react-native": "./dist/index.native.js",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"bin": {
		"headless-webview": "./bin/headless-webview",
		"headless-webview-linux-x64": "./bin/linux-x64/headless-webview",
		"headless-webview-darwin-arm64": "./bin/darwin-arm64/headless-webview",
		"headless-webview-darwin-x64": "./bin/darwin-x64/headless-webview",
		"headless-webview-win32-x64": "./bin/win32-x64/headless-webview.exe"
	},
	"files": [
		"dist",
		"src",
		"bin",
		"ios",
		"android",
		"!android/build",
		"!android/.gradle",
		"!android/.kotlin",
		"!ios/build",
		"!ios/DerivedData",
		"!ios/Pods",
		"react-native-headless-webview.podspec",
		"Package.swift",
		"README.md"
	],
	"codegenConfig": {
		"name": "RNHeadlessWebViewSpec",
		"type": "modules",
		"jsModuleName": "NativeHeadlessWebView",
		"outputDir": {
			"ios": "ios/generated",
			"android": "android/generated"
		},
		"android": {
			"javaPackageName": "com.printedjs.headlesswebview"
		}
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --build",
		"prebuild:crates": "bash scripts/build-prebuilts.sh"
	},
	"peerDependencies": {
		"react": "*",
		"react-native": "*"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-native": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@types/react-native": "^0.73.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	}
}
